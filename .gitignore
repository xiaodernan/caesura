node_modules/
dist/
*.local
.env
.env.*
!.env.example
docs/qa/shots/*
!docs/qa/shots/.gitkeep

# 本地工具数据（AI 工作记忆与技能），不属于产品源码
.workbuddy-ai/
.worktrees/
artifacts/
# KI-410：截图／量值日志是本地读数，不入库
vite.config.ts.timestamp-*.mjs
.tmp-*

# 覆盖率/红率量测的临时产物，与 .scratch 探测脚本一样不该入库
.cov-tmp/
.scratch/

# tsc 调试日志残留（2026-10-01 一批零字节与 <1KB 的，多为空），同族不入库
.tsc*.log

# KI-421：Maven 构建输出（Spring Cloud 微服务族）——含 .class/.jar（含 NUL），是构建产物不是源码
services/**/target/
