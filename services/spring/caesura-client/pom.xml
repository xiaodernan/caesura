<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>caesura</groupId>
    <artifactId>caesura-spring</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>caesura-client</artifactId>
  <name>Caesura Config Client</name>
  <description>Spring Cloud Config Client：向 caesura-config 索取配置，演示 Node 侧与 Spring 家族配置服务器的对账形状</description>

  <!-- 版本不在这一节钉：Boot 由父 pom（spring-boot-starter-parent 3.5.16）给出，
       Spring Cloud 由父 pom 的 BOM（spring-cloud-dependencies 2025.0.3）给出。
       此前自己钉 3.2.0／2022.0.4 会与父 BOM 撕裂出「Boot 3.5.16 × Cloud 2022.0.4」这种
       官方不兼容组合，启动即被 compatibility-verifier 拒绝（KI-453）。 -->

  <dependencies>
    <!-- Spring Cloud Config Client：从 caesura-config 拉取配置，编排侧只负责拿配置，判定仍由 Node 侧负责 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>caesura-client-0.1.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
