# Git attributes for CAESURA《止音纪元》
# 统一文本行尾（LF）与二进制标记

* text=auto

# 文本：LF
*.ts         text eol=lf
*.mjs        text eol=lf
*.mts        text eol=lf
*.d.mts      text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.txt        text eol=lf
*.svg        text eol=lf
LICENSE      text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# 二进制：不动
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.icns       binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.flac       binary
*.mp4        binary
*.webm       binary
*.glb        binary
*.gltf       binary
*.bin        binary
*.zip        binary
*.7z         binary
*.gz         binary
*.bz2        binary
