{
  "name": "caesura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CAESURA - original third-person action RPG vertical slice",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run --pool=forks",
    "test:flow": "vitest run --pool=forks tests/flow",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run lint && npm run validate:data && npm run test"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
