{
  "name": "caesura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CAESURA - original third-person action RPG vertical slice",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:flow": "node scripts/test.mjs tests/flow",
    "coverage": "node scripts/coverage.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "console:data": "node scripts/caesura-console-gen.mjs --out=console/snapshot.json",
    "lsm:bench": "node scripts/caesura-lsm-store.mjs",
    "hw:bench": "node scripts/caesura-hw-perf.mjs",
    "hash:bench": "node scripts/caesura-consistent-hash.mjs",
    "cache:bench": "node scripts/caesura-sharded-cache.mjs",
    "guard:bench": "node scripts/caesura-cache-guard.mjs",
    "ratelimit:bench": "node scripts/caesura-rate-limiter.mjs",
    "detect:bench": "node scripts/caesura-failure-detector.mjs",
    "bplus:bench": "node scripts/caesura-bplus-tree.mjs",
    "txn:bench": "node scripts/caesura-mvcc-txn.mjs",
    "disttxn:bench": "node scripts/caesura-distributed-txn.mjs",
    "raft:bench": "node scripts/caesura-raft-consensus.mjs",
    "status": "node scripts/phase-status.mjs",
    "status:embed": "node scripts/phase-status-embed.mjs",
    "release": "node scripts/release.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run validate:data && npm run test",
    "test:raw": "node scripts/test-raw.mjs",
    "red:rate": "node scripts/red-rate.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
