{
  "name": "caesura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CAESURA - original third-person action RPG vertical slice",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:flow": "node scripts/test.mjs tests/flow",
    "coverage": "node scripts/coverage.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "console:data": "node scripts/caesura-console-gen.mjs --out=console/snapshot.json",
    "lsm:bench": "node scripts/caesura-lsm-store.mjs",
    "hw:bench": "node scripts/caesura-hw-perf.mjs",
    "hash:bench": "node scripts/caesura-consistent-hash.mjs",
    "cache:bench": "node scripts/caesura-sharded-cache.mjs",
    "guard:bench": "node scripts/caesura-cache-guard.mjs",
    "ratelimit:bench": "node scripts/caesura-rate-limiter.mjs",
    "detect:bench": "node scripts/caesura-failure-detector.mjs",
    "bplus:bench": "node scripts/caesura-bplus-tree.mjs",
    "txn:bench": "node scripts/caesura-mvcc-txn.mjs",
    "disttxn:bench": "node scripts/caesura-distributed-txn.mjs",
    "raft:bench": "node scripts/caesura-raft-consensus.mjs",
    "dlock:bench": "node scripts/caesura-distributed-lock.mjs",
    "idgen:bench": "node scripts/caesura-idgen.mjs",
    "ratelimit:cluster:bench": "node scripts/caesura-distributed-ratelimit.mjs",
    "config:consistency:bench": "node scripts/caesura-config-consistency.mjs",
    "cache:coherency:bench": "node scripts/caesura-cache-coherency.mjs",
    "delivery:bench": "node scripts/caesura-message-delivery.mjs",
    "delay:bench": "node scripts/caesura-delay-queue.mjs",
    "retry:bench": "node scripts/caesura-retry-dlq.mjs",
    "group:bench": "node scripts/caesura-consumer-group.mjs",
    "backpressure:bench": "node scripts/caesura-backpressure.mjs",
    "log-compaction:bench": "node scripts/caesura-log-compaction.mjs",
    "bloom-filter:bench": "node scripts/caesura-bloom-filter.mjs",
    "cache-replacement:bench": "node scripts/caesura-cache-replacement.mjs",
    "stream-window:bench": "node scripts/caesura-stream-window.mjs",
    "hyperloglog:bench": "node scripts/caesura-hyperloglog.mjs",
    "crdt:bench": "node scripts/caesura-crdt.mjs",
    "spring-batch:bench": "node scripts/caesura-spring-batch.mjs",
    "distributed-session:bench": "node scripts/caesura-distributed-session.mjs",
    "load-balance:bench": "node scripts/caesura-spring-load-balance.mjs",
    "llm:proof": "node scripts/llm-npc-voice-proof.mjs",
    "llm:qa": "node scripts/llm-dialogue-qa.mjs",
    "llm:diff": "node scripts/llm-dialogue-diff.mjs",
    "llm:cand-qa": "node scripts/llm-candidate-qa.mjs",
    "llm-gateway:bench": "node scripts/caesura-llm-gateway.mjs",
    "circuit-breaker:bench": "node scripts/caesura-circuit-breaker.mjs",
    "idempotent-consumer:bench": "node scripts/caesura-idempotent-consumer.mjs",
    "consumer-rebalance:bench": "node scripts/caesura-consumer-rebalance.mjs",
    "priority-queue:bench": "node scripts/caesura-priority-queue.mjs",
    "batch-stream-join:bench": "node scripts/caesura-batch-stream-join.mjs",
    "cdc-outbox-join:bench": "node scripts/caesura-cdc-outbox-join.mjs",
    "spring-stream-binding:bench": "node scripts/caesura-spring-stream-binding.mjs",
    "spring-feign:bench": "node scripts/caesura-spring-feign.mjs",
    "gateway-routing:bench": "node scripts/caesura-gateway-routing.mjs",
    "trace-sampling:bench": "node scripts/caesura-trace-sampling.mjs",
    "outbox:bench": "node scripts/caesura-transactional-outbox.mjs",
    "redis:spring:bench": "node scripts/spring-redis-cache.mjs selfcheck",
    "status": "node scripts/phase-status.mjs",
    "status:embed": "node scripts/phase-status-embed.mjs",
    "release": "node scripts/release.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run validate:data && npm run test",
    "test:raw": "node scripts/test-raw.mjs",
    "red:rate": "node scripts/red-rate.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
