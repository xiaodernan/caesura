{
  "name": "caesura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CAESURA - original third-person action RPG vertical slice",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:flow": "node scripts/test.mjs tests/flow",
    "coverage": "node scripts/coverage.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run lint && npm run validate:data && npm run test",
    "test:raw": "node scripts/test-raw.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
