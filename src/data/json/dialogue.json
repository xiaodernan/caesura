            "text": "……你怎么会知道这个词？",
            "style": "blunt",
            "effects": {
              "setRelation": {
                "delta": 1
              }
            },
            "next": "n1"
          },
          {
            "id": "c2",
            "text": "（蹲下来，和它一起看）",
