        "id": "n1",
        "speaker": "npc_faceless",
        "emotion": "blank",
        "text": "（它把「哑钟」擦掉，又写：还没发生。然后它笑了——不是脸在笑，是你听见空气在笑。）",
        "choices": [
          {
            "id": "c1",
            "text": "跟我走。",
            "style": "blunt",
            "effects": {
              "setRelation": {
                "delta": 1
              },
              "setFlags": [
                "flag.faceless_met",
                "flag.faceless_first_writing"
