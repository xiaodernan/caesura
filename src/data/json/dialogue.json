    "nodes": [
      {
        "id": "n0",
        "speaker": "npc_haltrune",
        "emotion": "hostile",
        "text": "（一只手从暗处扣住你的后颈）别动。聋者。……你身上没有律政院的味道。那你可以活着听完这句话：前面那队兵已经死了。他们还在走。",
        "conditions": {
          "flags": {
            "not": [
              "flag.haltrune_met"
            ]
          }
        },
        "choices": [
          {
            "id": "c1",
            "text": "我不打断他们。",
            "style": "blunt",
            "effects": {
              "setRelation": {
                "delta": 1
              }
            },
            "next": "n1"
          },
          {
            "id": "c2",
            "text": "死人该躺下。",
