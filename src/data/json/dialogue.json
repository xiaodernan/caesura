            ]
          }
        },
        "choices": [
          {
            "id": "c1",
            "text": "是孩子。",
            "style": "poetic",
            "effects": {
              "setRelation": {
                "delta": 1
              },
              "setFlags": [
                "flag.faceless_answered"
