            "in": [
              "FACELESS.STEP3_VESSEL"
            ]
          }
        },
        "choices": [
          {
            "id": "c1",
            "text": "五环线索，在初句圣所。",
            "style": "blunt",
            "next": "n8"
          }
        ],
        "next": "n10"
      },
      {
        "id": "n8",
        "speaker": "npc_faceless",
        "emotion": "blank",
        "text": "（它在五环上各画了一笔：誓在大门楣、响在回廊柱、尘在供桌灰、归在深处祭坛。你得亲手把它们按顺序点亮。）",
        "conditions": {
          "flags": {
            "all": [
              "flag.faceless_answered"
            ],
            "not": [
              "flag.faceless_clue_ring_complete"
            ]
          }
        },
        "choices": [
          {
            "id": "c1",
            "text": "（记下了）",
            "style": "silent",
            "next": "n9"
          }
        ]
      },
      {
        "id": "n9",
        "speaker": "npc_faceless",
        "emotion": "blank",
        "text": "（它在最内环「归」上按下指尖：五环全亮，中间会裂开一条缝。那儿才是它该回去的地方。）",
        "conditions": {
          "flags": {
            "all": [
              "flag.faceless_answered"
            ],
            "not": [
              "flag.faceless_clue_ring_complete"
            ]
          }
        },
        "choices": [
          {
            "id": "c1",
            "text": "去圣所深处。",
            "style": "blunt",
            "effects": {
              "setFlags": [
                "flag.faceless_clue_ring_complete"
