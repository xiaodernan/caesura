[
 {
  "id": "DLG_BELLTONGUE",
  "npc": "npc_belltongue",
  "priority": 10,
  "rootNode": "n0",
  "fallbackNode": "n5",
  "nodes": [
   {
    "id": "n0",
    "speaker": "npc_belltongue",
    "emotion": "guarded",
    "text": "站住。……左耳那串断铃，剪的时候疼吗？",
    "conditions": {
     "flags": {
      "not": [
       "flag.belltongue_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "不疼。剪断的东西，从来不该疼第二次。",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 1
       },
       "setFlags": [
        "flag.belltongue_met"
       ],
       "startQuest": "q_bells"
      },
      "next": "n1"
     },
     {
      "id": "c2",
      "text": "……",
      "style": "silent",
      "effects": {
       "setRelation": {
        "delta": -1
       },
       "setFlags": [
        "flag.belltongue_met"
       ],
       "startQuest": "q_bells"
      },
      "next": "n2"
     }
    ]
   },
   {
    "id": "n1",
    "speaker": "npc_belltongue",
    "emotion": "measured",
    "text": "不疼的人我见过三种：死透的，铸坏的，和把自己当钟铸的。你是第三种。炉边坐——别碰那口小钟，它醒了会说话，我还没想好怎么接它的话。",
    "choices": [
     {
      "id": "c1",
      "text": "四口钟都响。",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 1
       }
      },
      "next": "n3"
     },
     {
      "id": "c2",
      "text": "先说第三口。你亲手铸坏的那口。",
      "style": "provoke",
      "next": "n4"
     }
    ]
   },
   {
    "id": "n2",
    "speaker": "npc_belltongue",
    "emotion": "quiet",
    "text": "不答也好。答的人里，骗子占九成。……去寻科温，他缺一双不怕吵的眼睛。我缺的，你已经有——（她指了指你的左耳）一副对这个世界免疫的耳朵。",
    "next": null
   },
   {
    "id": "n3",
    "speaker": "npc_belltongue",
    "emotion": "dry",
    "text": "贪心的报价。……成交。钟舌我给你，路你自己量。丑话说在前头：第三口钟是我亲手铸坏的，你修开它那天，记得先想好要不要听完。",
    "effects": {
     "notify": "《裂舌的断面》记入谱册 —— 去钟坠院，首钟的断舌还在钟壳里侧"
    },
    "next": null
   },
   {
    "id": "n4",
    "speaker": "npc_belltongue",
    "emotion": "closed",
    "text": "第三口……是我铸坏的。别急着问为什么。先去看第一口的断面——它在钟壳里侧，还带着灰。看完你就知道该问什么了。",
    "effects": {
     "notify": "《裂舌的断面》记入谱册 —— 去钟坠院，首钟的断舌还在钟壳里侧"
    },
    "next": null
   },
   {
    "id": "n5",
    "speaker": "npc_belltongue",
    "emotion": "working",
    "text": "（她没抬头，锤子还在敲）路量到哪了？",
    "conditions": {
     "flags": {
      "all": [
       "flag.belltongue_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "断面是从里往外炸的。我看了。",
      "style": "blunt",
      "conditions": {
       "hasItem": {
        "id": "it_bell_tongue"
       },
       "quest": {
        "id": "q_bells",
        "in": [
         "BELLS.STEP1_OPEN"
        ]
       }
      },
      "effects": {
       "setRelation": {
        "delta": 1
       },
       "setFlags": [
        "flag.bell_tongue_examined"
       ],
       "notify": "她停下手里的锤：「……从里面。你确定。」"
      },
      "next": "n6"
     },
     {
      "id": "c2",
      "text": "还没到钟坠院。",
      "style": "silent",
      "next": null
     },
     {
      "id": "c3",
      "text": "（什么也不说，站着看她敲）",
      "style": "silent",
      "next": null
     },
     {
      "id": "c4",
      "text": "（把三段拾音石放在她的砧上）",
      "style": "silent",
      "conditions": {
       "hasItem": {
        "id": "it_echo_slate",
        "count": 3
       },
       "quest": {
        "id": "q_bells",
        "gte": "BELLS.STEP2_THIRD"
       }
      },
      "effects": {
       "takeItem": {
        "id": "it_echo_slate",
        "count": 3
       },
       "setRelation": {
        "delta": 1
       },
       "setFlags": [
        "flag.bell_keymod_found"
       ],
       "notify": "三段环境声合听：仪典那晚，整支合唱被按下了半个音 —— 降 B"
      },
      "next": "n9"
     }
    ]
   },
   {
    "id": "n6",
    "speaker": "npc_belltongue",
    "emotion": "still",
    "text": "（她把锤子放下了。五十年，这间铁铺第一次没有锤声。）说下去。",
    "conditions": {
     "quest": {
      "id": "q_bells",
      "gte": "BELLS.STEP1_JUDGED"
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "首钟不是坠毁炸的。是共鸣。",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 2
       },
       "setFlags": [
        "flag.belltongue_told",
        "flag.bells_repair_open"
       ],
       "notify": "《唤四钟》记入谱册 —— 按爆痕顺藤修其余三钟"
      },
      "next": "n7"
     },
     {
      "id": "c2",
      "text": "（把断面收进衣袋）",
      "style": "silent",
      "effects": {
       "setRelation": {
        "delta": -1
       },
       "setFlags": [
        "flag.belltongue_hidden",
        "flag.bells_repair_open"
       ],
       "notify": "你把那截舌头收了起来 —— 它会在你的包里继续响"
      },
      "next": "n8"
     }
    ]
   },
   {
    "id": "n7",
    "speaker": "npc_belltongue",
    "emotion": "unsteady",
    "text": "共鸣。……五十年了。第一个说出这个词的人不是我。去吧，把另外三口也听一遍。听完你会恨我，或者会懂我——都行。",
    "next": null
   },
   {
    "id": "n8",
    "speaker": "npc_belltongue",
    "emotion": "quiet",
    "text": "……你藏起来了。行。等你哪天想说了，炉子还在这儿，锤子也还在这儿。",
    "next": null
   },
   {
    "id": "n9",
    "speaker": "npc_belltongue",
    "emotion": "unsteady",
    "text": "降 B。……那晚有人把整支合唱按下了半个音，而且是从最里面按的。不是我。我这辈子只铸坏过一口钟——可有人改过一整支曲子。",
    "next": "n10"
   },
   {
    "id": "n10",
    "speaker": "npc_belltongue",
    "emotion": "closed",
    "text": "（她站起来走到门口，又停下）第四口我不修。那口钟里封着被放逐的人最后一声。你要敲，自己去敲——我不听。",
    "choices": [
     {
      "id": "c1",
      "text": "里面封着谁？",
      "style": "blunt",
      "next": "n11"
     },
     {
      "id": "c2",
      "text": "（不问了，把锤子放回原处）",
      "style": "silent",
      "effects": {
       "setRelation": {
        "delta": 1
       },
       "setFlags": [
        "flag.belltongue_refused"
       ],
       "notify": "她没回头。你听见炉火被拨了一下，又一下"
      },
      "next": "n12"
     }
    ]
   },
   {
    "id": "n11",
    "speaker": "npc_belltongue",
    "emotion": "unsteady",
    "text": "（她很久没说话）我放逐的不是聋者，是——（她闭口，转身去拨炉火）……出去。今天到此为止。",
    "effects": {
     "setRelation": {
      "delta": -1
     },
     "setFlags": [
      "flag.belltongue_refused"
     ],
     "notify": "那半句话停在炉边 —— 它缺的后半截，在别处"
    },
    "next": null
   },
   {
    "id": "n12",
    "speaker": "npc_belltongue",
    "emotion": "quiet",
    "text": "……谢谢。锤子我收着。哪天你想敲了，它还在。",
    "next": null
   }
  ]
 },
 {
  "id": "DLG_CORVIN",
  "npc": "npc_corvin",
  "priority": 10,
  "rootNode": "n0",
  "fallbackNode": "n5",
  "nodes": [
   {
    "id": "n0",
    "speaker": "npc_corvin",
    "emotion": "curious",
    "text": "站住。你身上有遗响的余味，而且很新。……律政院末代档案官，科温。我在写一本书，书里缺一节：会唱歌的核。",
    "conditions": {
     "flags": {
      "not": [
       "flag.corvin_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "什么价钱？",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 1
       }
      },
      "next": "n1"
     },
     {
      "id": "c2",
      "text": "我不替人打猎。",
      "style": "provoke",
      "effects": {
       "setRelation": {
        "delta": -1
       }
      },
      "next": "n2"
     },
     {
      "id": "c3",
      "text": "……",
      "style": "silent",
      "next": "n2"
     }
    ]
   },
   {
    "id": "n1",
    "speaker": "npc_corvin",
    "emotion": "eager",
    "text": "价钱是知识。雾语林里有一只异色驼鼓，它背上的鼓会自己换调。把它的核带给我，我给你整片息声领的弱点图谱——哪块甲怕震裂，哪个壳期能剥。",
    "choices": [
     {
      "id": "c1",
      "text": "成交。",
      "style": "blunt",
      "effects": {
       "setFlags": [
        "flag.corvin_met",
        "flag.corvin_contract_signed"
       ],
       "startQuest": "q_corvin",
       "notify": "《第一份契约》记入谱册 —— 要「会唱歌」的那种核，死透的不算"
      },
      "next": "n3"
     },
     {
      "id": "c2",
      "text": "先让我看看你的档案室。",
      "style": "poetic",
      "effects": {
       "setFlags": [
        "flag.corvin_met"
       ],
       "startQuest": "q_corvin"
      },
      "next": "n4"
     }
    ]
   },
   {
    "id": "n2",
    "speaker": "npc_corvin",
    "emotion": "cold",
    "text": "……不勉强。但我建议你别把背对着我说话，聋者。我记性好。",
    "effects": {
     "setFlags": [
      "flag.corvin_met"
     ]
    },
    "next": null
   },
   {
    "id": "n3",
    "speaker": "npc_corvin",
    "emotion": "pleased",
    "text": "（他蘸墨写下什么）很好。记住：要「会唱歌」的那一种。死透的核不会换调，只会烂。",
    "next": null
   },
   {
    "id": "n4",
    "speaker": "npc_corvin",
    "emotion": "wary",
    "text": "档案室烧过一半。剩下的半间，只对签了契约的人开门。",
    "once": true,
    "next": null
   },
   {
    "id": "n5",
    "speaker": "npc_corvin",
    "emotion": "brisk",
    "text": "核带来了吗？",
    "conditions": {
     "flags": {
      "all": [
       "flag.corvin_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "（把振源核放在桌上）",
      "style": "blunt",
      "conditions": {
       "hasItem": {
        "id": "it_resonance_core"
       },
       "quest": {
        "id": "q_corvin",
        "in": [
         "CORVIN.STEP2_DELIVER"
        ]
       }
      },
      "effects": {
       "takeItem": {
        "id": "it_resonance_core",
        "count": 1
       },
       "setRelation": {
        "delta": 1
       },
       "notify": "他把核举到灯下听了很久 —— 弱点图谱的第一页已经写在你眼里",
       "setFlags": [
        "flag.corvin_core_delivered"
       ]
      },
      "next": "n6"
     },
     {
      "id": "c2",
      "text": "还没有。",
      "style": "silent",
      "next": null
     }
    ]
   },
   {
    "id": "n6",
    "speaker": "npc_corvin",
    "emotion": "quiet",
    "text": "……它真的在唱。七十三年了，我以为我妻子那批是最后一批会唱的。谢谢你，聋者。你让我少写了一页谎。",
    "next": null
   }
  ]
 },
 {
  "id": "DLG_MEG",
  "npc": "npc_meg",
  "priority": 10,
  "rootNode": "n0",
  "fallbackNode": "n3",
  "nodes": [
   {
    "id": "n0",
    "speaker": "npc_meg",
    "emotion": "bored",
    "text": "别站那么近，你踩到我摊子了。……等等。你胸口那颗音色石，灭的。莉安给你的吧？",
    "conditions": {
     "flags": {
      "not": [
       "flag.meg_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "你认识她。",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 1
       }
      },
      "next": "n1"
     },
     {
      "id": "c2",
      "text": "（按住胸口）",
      "style": "silent",
      "next": "n1"
     }
    ]
   },
   {
    "id": "n1",
    "speaker": "npc_meg",
    "emotion": "soft",
    "text": "我认识她？我替她保管「她还愿意回来的那部分」。第一段记忆，赊给你——不要钱，只要你听完告诉我：这段录音是在哪儿录的。",
    "choices": [
     {
      "id": "c1",
      "text": "（听完）……这里。休垒。她一直守在自家门口。",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 2
       },
       "setFlags": [
        "flag.meg_met",
        "flag.meg_first_fragment"
       ],
       "startQuest": "q_meg",
       "notify": "《第一块拼图》记入谱册 —— 她一直守在莉安家门口"
      },
      "next": "n2"
     },
     {
      "id": "c2",
      "text": "听不出来。",
      "style": "silent",
      "effects": {
       "setFlags": [
        "flag.meg_met"
       ],
       "startQuest": "q_meg"
      },
      "next": "n2"
     }
    ]
   },
   {
    "id": "n2",
    "speaker": "npc_meg",
    "emotion": "even",
    "text": "（她把那枚晶片收回喉咙里，动作很熟练）……不急。录音会等人，比人耐心。想好了再来听第二遍。",
    "next": null
   },
   {
    "id": "n3",
    "speaker": "npc_meg",
    "emotion": "businesslike",
    "text": "第二段要拿东西换：你见过的一段声音。哑带的死寂，或者首钟炸开的断面——随便哪一段，只要是你亲耳听的。",
    "conditions": {
     "flags": {
      "all": [
       "flag.meg_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "首钟的断面我听过。是从里往外炸的。",
      "style": "blunt",
      "conditions": {
       "flags": {
        "all": [
         "flag.belltongue_told"
        ]
       }
      },
      "effects": {
       "setRelation": {
        "delta": 1
       },
       "setFlags": [
        "flag.meg_second_fragment"
       ],
       "notify": "第二段记忆入账：仪典前夜，莉安唱错了一个音——她知道"
      },
      "next": "n4"
     },
     {
      "id": "c2",
      "text": "还没攒够。",
      "style": "silent",
      "next": null
     }
    ]
   },
   {
    "id": "n4",
    "speaker": "npc_meg",
    "emotion": "careful",
    "text": "……从里往外。难怪她那天回来时，耳朵是红的。第二段记忆在这儿：仪典前夜，她唱错了一个音。她知道。",
    "next": null
   }
  ]
 },
 {
  "id": "DLG_FACELESS",
  "npc": "npc_faceless",
  "priority": 10,
  "rootNode": "n0",
  "fallbackNode": "n3",
  "nodes": [
   {
    "id": "n0",
    "speaker": "npc_faceless",
    "emotion": "blank",
    "text": "（它蹲在休垒的水缸边，用指头在灰上写。写完就擦。你走近时它抬头——兜帽下没有五官，只有「听」的形状。）灰上剩着两个字：哑钟。",
    "conditions": {
     "flags": {
      "not": [
       "flag.faceless_met"
      ]
     }
    },
    "choices": [
     {
      "id": "c1",
      "text": "……你怎么会知道这个词？",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 1
       }
      },
      "next": "n1"
     },
     {
      "id": "c2",
      "text": "（蹲下来，和它一起看）",
      "style": "silent",
      "next": "n1"
     }
    ]
   },
   {
    "id": "n1",
    "speaker": "npc_faceless",
    "emotion": "blank",
    "text": "（它把「哑钟」擦掉，又写：还没发生。然后它笑了——不是脸在笑，是你听见空气在笑。）",
    "choices": [
     {
      "id": "c1",
      "text": "跟我走。",
      "style": "blunt",
      "effects": {
       "setRelation": {
        "delta": 1
       },
       "setFlags": [
        "flag.faceless_met",
        "flag.faceless_first_writing"
       ],
       "startQuest": "q_faceless",
       "notify": "《第一次代写》记入谱册 —— 它写的不是话，是还没发生的事"
      },
      "next": "n2"
     },
     {
      "id": "c2",
      "text": "（什么也不说，转身离开）",
      "style": "silent",
      "effects": {
       "setRelation": {
        "delta": -1
       },
       "setFlags": [
        "flag.faceless_met",
        "flag.faceless_first_writing"
       ],
       "startQuest": "q_faceless"
      },
      "next": "n2"
     }
    ]
   },
   {
    "id": "n2",
    "speaker": "npc_faceless",
    "emotion": "blank",
    "text": "（它跟在你身后半步。你回头时，它已经在那儿了。）",
    "next": null
   },
   {
    "id": "n3",
    "speaker": "npc_faceless",
    "emotion": "blank",
    "text": "（它抬头看你，然后在灰上写了一个字。你还没看清，它就擦了。）",
    "conditions": {
     "flags": {
      "all": [
       "flag.faceless_met"
      ]
     }
    },
    "next": null
   }
  ]
 },
 {
  "id": "DLG_HALTRUNE",
  "npc": "npc_haltrune",
  "priority": 10,
  "rootNode": "n0",
  "fallbackNode": "n5",
  "nodes": [
   {
    "id": "n0",
    "speaker": "npc_haltrune",
    "emotion": "hostile",
